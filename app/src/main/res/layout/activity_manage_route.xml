<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manageroutes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".hereroutes.ManageRoute">

    <!-- Map View (MapLibre GL - ESRI World Imagery satellite) -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- My Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="My Location"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/fab_background"
        app:tint="@color/fab_icon"
        app:fabSize="normal"
        app:elevation="10dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search FAB (bottom-left, opens search overlay) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Search location"
        android:src="@drawable/ic_search"
        app:backgroundTint="@color/fab_background"
        app:tint="@color/ui_text_primary"
        app:fabSize="normal"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_container"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Offline Status Indicator -->
    <TextView
        android:id="@+id/tv_offline_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/offline_status_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Offline maps loading..."
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fab_my_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Include Search Overlay -->
    <include layout="@layout/search_overlay_layout" />

    <!-- Include Bottom Container -->
    <include layout="@layout/bottom_container_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>