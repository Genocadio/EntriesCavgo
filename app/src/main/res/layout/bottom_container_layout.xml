<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_container"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/modern_bottom_container"
    android:elevation="12dp"
    android:orientation="vertical"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <!-- Compact Search Trigger (hidden, replaced by FAB in main layout) -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Hidden TextViews needed by UIController -->
    <TextView
        android:id="@+id/search_hint_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="Search pickup location" />

    <ImageButton
        android:id="@+id/clear_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Place Details Container (Single Location) -->
    <LinearLayout
        android:id="@+id/place_details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Place Info -->
        <LinearLayout
            android:id="@+id/place_info_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_place_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_primary"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                tools:text="Selected Place Name" />

            <TextView
                android:id="@+id/tv_place_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15sp"
                android:textColor="@color/ui_text_secondary"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                tools:text="123 Example Street, City, Country" />

            <TextView
                android:id="@+id/tv_place_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/modern_place_type_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="Restaurant" />

        </LinearLayout>

        <!-- Inline Place Edit Form (single tap on marker) -->
        <LinearLayout
            android:id="@+id/place_edit_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Place Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
android:textColor="@color/ui_text_primary"
                    android:fontFamily="sans-serif-medium" />

                <ImageButton
                    android:id="@+id/btn_place_edit_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/modern_round_icon_button"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="Marker options"
                    android:padding="8dp" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Custom Name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_place_custom_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Place Name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_place_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="District"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/spinner_place_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:completionThreshold="1"
                    android:dropDownHeight="200dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_place"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/modern_button_primary"
                android:text="Save Place"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:elevation="3dp" />

        </LinearLayout>

        <!-- Single Location Action Buttons -->
        <LinearLayout
            android:id="@+id/location_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btn_save_location"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/modern_button_outline"
                android:text="Save"
                android:textColor="@color/primary_color"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:drawableTop="@android:drawable/ic_menu_save"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btn_clear_location"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/modern_button_outline"
                android:text="Clear"
                android:textColor="@color/primary_color"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:drawableTop="@android:drawable/ic_menu_close_clear_cancel"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btn_add_destination"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/modern_button_primary"
                android:text="Destination"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:drawableTop="@android:drawable/ic_menu_directions"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:elevation="3dp" />

            <Button
                android:id="@+id/btn_add_waypoint"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/modern_button_accent"
                android:text="Waypoint"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:drawableTop="@android:drawable/ic_menu_add"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:elevation="3dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Include Route Summary Container -->
    <include layout="@layout/route_summary_layout" />

</LinearLayout>